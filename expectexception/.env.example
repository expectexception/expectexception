DEBUG=True
SECRET_KEY=your-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Auth ---------------------------------------------------------------
# MUST be identical on Render and on the local failover server. JWTs are
# signed, not bound to an instance, so the whole Render <-> local failover
# path (apps/users/authentication.py) only works if both sides verify with
# the same key. Defaults to SECRET_KEY, which differs per instance — leaving
# it unset silently disables cross-instance failover.
JWT_SIGNING_KEY=shared-jwt-signing-key-same-on-every-instance

# Absolute base URL of the React frontend. Used to build the links inside
# password-reset and email-verification emails.
FRONTEND_URL=http://localhost:3000

# Number of trusted proxies in front of Django (Render router / Cloudflare
# Tunnel = 1). Controls which X-Forwarded-For entry is used as the client
# identity for rate limiting. Set to 0 when running with no proxy.
DRF_NUM_PROXIES=1

# Auth endpoint rate limits (DRF throttle syntax).
THROTTLE_AUTH_LOGIN=10/min
THROTTLE_AUTH_REGISTER=5/hour
THROTTLE_AUTH_PASSWORD_RESET=5/hour

# --- Ops ----------------------------------------------------------------
# Override when the container has written root-owned log files that the host
# user cannot open (otherwise every manage.py command fails at startup).
# DJANGO_LOG_DIR=/tmp/expexc-logs
